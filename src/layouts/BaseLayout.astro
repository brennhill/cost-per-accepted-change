---
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/400-italic.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/source-serif-4/600-italic.css';
import '../styles/global.css';
import Mark from '../components/Mark.astro';

interface Props {
  title: string;
  description?: string;
  path?: string;
  /** Open Graph type. Default 'article'; pass 'website' for the homepage. */
  ogType?: 'article' | 'website';
  /**
   * Page-specific JSON-LD node(s) (DefinedTerm, FAQPage, TechArticle, …).
   * Merged into the sitewide @graph; reference the shared nodes by their
   * stable @id (e.g. `${SITE}/#person-brennhill`).
   */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Ancestor crumbs for deep pages, in order, excluding Home and the current
   * page (e.g. [{ name: 'Articles', path: '/articles' }]). When omitted, the
   * breadcrumb is simply Home › {title}.
   */
  breadcrumbs?: { name: string; path: string }[];
}

const {
  title,
  description = "AI FinOps: measuring and governing the dollar cost of producing and running trusted AI software — anchored by cost per accepted change and cost per accepted action.",
  path = '/',
  ogType = 'article',
  jsonLd,
  breadcrumbs = [],
} = Astro.props;

const SITE = 'https://aifinops.dev';
const SITE_NAME = 'AI FinOps';

// The homepage passes a fully-formed, AI-FinOps-led title; subpages get the
// "{title} — AI FinOps" suffix.
const fullTitle = path === '/' ? title : `${title} — ${SITE_NAME}`;

const canonical = `${SITE}${path === '/' ? '' : path}`;
const ogImage = `${SITE}/og-image.png`;
const ogImageAlt = 'AI FinOps — the dollar cost of producing and running trusted AI software.';

// --- Structured data (JSON-LD) ---------------------------------------------
// A stable @graph is emitted on every page: the WebSite and its author/
// publisher (Brenn Hill). Subpages also get a Home › {title} breadcrumb.
// Page-specific nodes arrive via the `jsonLd` prop and reference the shared
// nodes by @id, so the graph stays internally linked for search engines.
const personId = `${SITE}/#person-brennhill`;
const websiteId = `${SITE}/#website`;

const baseGraph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': websiteId,
    url: SITE,
    name: 'AI FinOps',
    alternateName: 'AI FinOps — cost per accepted change & cost per accepted action',
    description:
      'AI FinOps: measuring and governing the dollar cost of producing and running trusted AI software, anchored by cost per accepted change and cost per accepted action.',
    inLanguage: 'en',
    publisher: { '@id': personId },
    author: { '@id': personId },
    relatedLink: ['https://looprails.dev', 'https://braceframework.org'],
  },
  {
    '@type': 'Person',
    '@id': personId,
    name: 'Brenn Hill',
    url: 'https://brennhill.substack.com',
    sameAs: [
      'https://www.linkedin.com/in/brennhill/',
      'https://brennhill.substack.com',
      'https://github.com/brennhill',
    ],
  },
];

const crumbTrail = [
  { name: 'Home', item: SITE },
  ...breadcrumbs.map((b) => ({ name: b.name, item: `${SITE}${b.path}` })),
  { name: title, item: canonical },
];

const breadcrumb: Record<string, unknown>[] =
  path === '/'
    ? []
    : [
        {
          '@type': 'BreadcrumbList',
          '@id': `${canonical}#breadcrumb`,
          itemListElement: crumbTrail.map((c, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: c.name,
            item: c.item,
          })),
        },
      ];

const pageNodes = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [...baseGraph, ...breadcrumb, ...pageNodes],
};

const nav = [
  { href: '/', label: 'Definition' },
  { href: '/start', label: 'Start' },
  { href: '/calculator', label: 'Calculator' },
  { href: '/use', label: 'Use' },
  { href: '/instrument', label: 'Instrument' },
  { href: '/templates', label: 'Templates' },
  { href: '/measurement', label: 'Compare' },
  { href: '/articles', label: 'Articles' },
  { href: '/faq', label: 'FAQ' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Brenn Hill" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta name="theme-color" content="#fbfaf6" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="AI FinOps" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <title>{fullTitle}</title>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site">
      <div class="inner">
        <a href="/" class="brand" aria-label="AI FinOps — home">
          <Mark size={30} class="brand-mark" ariaHidden={true} />
          <span class="brand-text">AI FinOps</span>
        </a>
        <nav aria-label="Main">
          {nav.map((item) => (
            <a
              href={item.href}
              aria-current={path === item.href ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <!--
      Analytics — both cookieless, no consent banner needed.
      Cloudflare Web Analytics is auto-injected via the Pages dashboard.
      GoatCounter is the script tag below. CSP allowlists for both are
      in public/_headers.
    -->
    <script
      data-goatcounter="https://costperacceptedchange.goatcounter.com/count"
      async
      src="//gc.zgo.at/count.js"
    ></script>
    <footer class="site">
      <div class="inner">
        <div class="col">
          <span class="footer-byline">
            AI FinOps — by <a href="https://www.linkedin.com/in/brennhill/">Brenn Hill</a>, from <em>The Delivery Gap</em> (2026). <a href="/cite">Cite</a> · <a href="/press">Press</a>.
          </span>
          <span class="footer-meta">
            Companion frameworks: <a href="https://looprails.dev">LoopRails</a> · <a href="https://braceframework.org">BRACE</a> · Eval-Driven Development <span class="soon">(soon)</span>.
          </span>
          <span class="footer-meta">
            Subscribe at <a href="https://brennhill.substack.com">brennhill.substack.com</a>.
          </span>
        </div>
        <div class="col col-right">
          <a href="https://github.com/brennhill/cost-per-accepted-change">Source on GitHub</a>
        </div>
      </div>
    </footer>
  </body>
</html>
