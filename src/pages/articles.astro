---
import BaseLayout from '../layouts/BaseLayout.astro';

const SITE = 'https://costperacceptedchange.org';

const jsonLd = {
  '@type': 'CollectionPage',
  '@id': `${SITE}/articles#collection`,
  name: 'Articles',
  description:
    'Applied writing on cost per accepted change — how to put the metric to work, and what it would have caught in real, publicly-reported AI rollouts.',
  isPartOf: { '@id': `${SITE}/#website` },
  about: { '@id': `${SITE}/#definedterm` },
};
---
<BaseLayout
  title="Articles"
  description="Applied writing on cost per accepted change — how to put the metric to work, and what it would have caught in real, publicly-reported AI rollouts."
  path="/articles"
  jsonLd={jsonLd}
>
  <article class="page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span class="sep">›</span>Articles
    </nav>

    <p class="eyebrow">Applied writing</p>
    <h1>Articles</h1>
    <p class="lede">
      The <a href="/">definition</a>, the <a href="/calculator">calculator</a>, and the <a href="/instrument">instrumentation guide</a> tell you what cost per accepted change is and how to compute it. These articles are about putting it to work, extending it to new kinds of work, and what it would have caught.
    </p>

    <div class="template-grid">
      <div class="template-card">
        <p class="meta">Framework</p>
        <h3><a href="/articles/cost-per-accepted-action">Cost per accepted action</a></h3>
        <p>
          The runtime sibling of cost per accepted change — a FinOps metric for <em>running</em> AI agents. Price the agent work that was accepted and stayed accepted, not the tokens or runs it consumed. Includes the formula, a worked example, an Inform → Optimize → Operate model, and the LoopRails oversight bridge.
        </p>
        <p><a href="/articles/cost-per-accepted-action">Read the framework →</a></p>
      </div>

      <div class="template-card">
        <p class="meta">Series</p>
        <h3><a href="/articles/field-notes">Field notes</a></h3>
        <p>
          Illustrative analyses of real, publicly-reported AI rollouts — Microsoft and GitHub Copilot, Uber, Klarna, the 2024–2025 enterprise AI-mandate wave. Each one reads the public record through the cost-per-accepted-change lens: where velocity was measured, where value and cost were not, and what governing on the accepted-change number would have surfaced earlier.
        </p>
        <p><a href="/articles/field-notes">Read the field notes →</a></p>
      </div>
    </div>
  </article>
</BaseLayout>
