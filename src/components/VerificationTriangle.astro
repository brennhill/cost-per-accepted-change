---
interface Props {
  highlight?: 'intent' | 'verification' | 'cost';
  size?: number;
  class?: string;
}

const { highlight = 'cost', size = 240, class: className } = Astro.props;
const titleMap = {
  intent: 'Verification Triangle — intent clarity highlighted',
  verification: 'Verification Triangle — verification quality highlighted',
  cost: 'Verification Triangle — cost vertex highlighted',
};
---
<!--
  viewBox carries 40 units of horizontal padding on each side (x: -40 to 280)
  so the wide vertex labels — "Verification quality" especially — don't clip
  past the edge. The triangle itself stays centered on x=120, and width/height
  scale from the original 240-unit basis so its on-page size is unchanged.
-->
<svg
  width={Math.round(size * 4 / 3)}
  height={Math.round(size * 11 / 12)}
  viewBox="-40 0 320 220"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label={titleMap[highlight]}
  class={className}
>
  <title>{titleMap[highlight]}</title>
  <!-- Triangle edges (drawn as three separate lines so we can style them) -->
  <line x1="120" y1="34" x2="34" y2="180" stroke="currentColor" stroke-width="1.4" opacity="0.55" />
  <line x1="120" y1="34" x2="206" y2="180" stroke="currentColor" stroke-width="1.4" opacity="0.55" />
  <line x1="34" y1="180" x2="206" y2="180" stroke="currentColor" stroke-width="1.4" opacity="0.55" />

  <!-- Intent vertex (top) -->
  <circle
    cx="120"
    cy="34"
    r={highlight === 'intent' ? 10 : 5}
    fill={highlight === 'intent' ? 'currentColor' : 'transparent'}
    stroke="currentColor"
    stroke-width="1.6"
  />
  <text
    x="120"
    y="20"
    text-anchor="middle"
    font-family="Source Serif 4, Iowan Old Style, Charter, Georgia, serif"
    font-size="13"
    font-weight="600"
    fill="currentColor"
  >Intent clarity</text>

  <!-- Eval vertex (bottom-left) -->
  <circle
    cx="34"
    cy="180"
    r={highlight === 'verification' ? 10 : 5}
    fill={highlight === 'verification' ? 'currentColor' : 'transparent'}
    stroke="currentColor"
    stroke-width="1.6"
  />
  <text
    x="34"
    y="204"
    text-anchor="middle"
    font-family="Source Serif 4, Iowan Old Style, Charter, Georgia, serif"
    font-size="13"
    font-weight="600"
    fill="currentColor"
  >Verification quality</text>

  <!-- Cost vertex (bottom-right) -->
  <circle
    cx="206"
    cy="180"
    r={highlight === 'cost' ? 10 : 5}
    fill={highlight === 'cost' ? 'currentColor' : 'transparent'}
    stroke="currentColor"
    stroke-width="1.6"
  />
  <text
    x="206"
    y="204"
    text-anchor="middle"
    font-family="Source Serif 4, Iowan Old Style, Charter, Georgia, serif"
    font-size="13"
    font-weight="600"
    fill="currentColor"
  >Cost</text>

  <!-- Centered framework label -->
  <text
    x="120"
    y="118"
    text-anchor="middle"
    font-family="Helvetica, sans-serif"
    font-size="9"
    font-weight="600"
    letter-spacing="2"
    fill="currentColor"
    opacity="0.55"
  >THE VERIFICATION</text>
  <text
    x="120"
    y="132"
    text-anchor="middle"
    font-family="Helvetica, sans-serif"
    font-size="9"
    font-weight="600"
    letter-spacing="2"
    fill="currentColor"
    opacity="0.55"
  >TRIANGLE</text>
</svg>
