---
/**
 * The companion-frameworks module. Links to the sibling open frameworks for
 * trustworthy AI delivery. Eval-Driven Development is rendered unlinked until
 * evaldrivendevelopment.dev is live (flip `live: true` when it ships).
 */
interface Props {
  intro?: string;
}

const {
  intro = 'Cost per accepted change is one of a family of open, vendor-neutral frameworks for shipping software you can trust in the AI era. They compose — each measures or guards a different face of the same goal.',
} = Astro.props;

const frameworks = [
  {
    role: 'Verification quality',
    name: 'Eval-Driven Development',
    href: 'https://evaldrivendevelopment.dev',
    live: false,
    blurb: 'How well you check AI output — write the evals before the feature, and let them gate the work.',
  },
  {
    role: 'Agent oversight',
    name: 'LoopRails',
    href: 'https://looprails.dev',
    live: true,
    blurb: 'Human-in-the-loop control for AI agents: which actions a human reviews, and proof the oversight actually catches mistakes.',
  },
  {
    role: 'Agent security',
    name: 'BRACE',
    href: 'https://braceframework.org',
    live: true,
    blurb: 'Security controls for autonomous agents across build-time, run-time, agent identity, configuration, and ecosystem.',
  },
];
---
<aside class="related-frameworks">
  <span class="label">Related frameworks</span>
  <p class="rf-intro">{intro}</p>
  <ul>
    {frameworks.map((f) => (
      <li>
        <span class="rf-role">{f.role}</span>
        {f.live ? (
          <a class="rf-name" href={f.href}>{f.name}</a>
        ) : (
          <span class="rf-name">{f.name} <span class="rf-soon">· coming soon</span></span>
        )}
        <span class="rf-blurb">{f.blurb}</span>
      </li>
    ))}
  </ul>
</aside>
