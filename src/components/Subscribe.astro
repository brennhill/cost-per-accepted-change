---
// Email capture for the Cost Per Accepted Change worksheet.
// Kit form b1c7f03bac — its confirmation email delivers cpac-worksheet.pdf.
---
<section class="subscribe" aria-label="Get the Cost Per Accepted Change worksheet">
  <div class="subscribe-inner">
    <p class="subscribe-h">What does a trustworthy change actually cost you?</p>
    <p class="subscribe-sub">
      Get the free one-page Cost Per Accepted Change worksheet and run the numbers
      for your own team — plus the occasional essay on AI delivery economics.
      Unsubscribe anytime.
    </p>
    <script async data-uid="b1c7f03bac" src="https://aiacceleration.kit.com/b1c7f03bac/index.js"></script>
  </div>
</section>

<style>
  .subscribe {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    background: var(--paper-tint);
    padding: 2.25rem 1.25rem;
    margin: 2.5rem 0;
  }
  .subscribe-inner {
    max-width: 36rem;
    margin: 0 auto;
    text-align: center;
  }
  .subscribe-h {
    font-family: var(--font-serif);
    color: var(--accent);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.25;
    margin: 0 0 0.5rem;
  }
  .subscribe-sub {
    color: var(--ink-muted);
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0 0 1.1rem;
  }
</style>
